      "gridPos": {"h": 7, "w": 16, "x": 16, "y": 16},
      "id": 8,
      "options": {"showHeader": true, "sortBy": [{"desc": false, "displayName": "job"}]},
      "targets": [{"expr": "up", "format": "table", "instant": true, "legendFormat": "{{job}}", "refId": "A"}],
      "title": "Prometheus targets (1 = UP)",
      "type": "table"
    }
